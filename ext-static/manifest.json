{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Pouso",
  "description": "__MSG_desc__",
  "version": "1.0.0",
  "default_locale": "pt_BR",
  "author": "Zarpa",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": { "default_title": "__MSG_action__", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "search", "alarms", "favicon"],
  "optional_permissions": ["bookmarks", "tabs", "history"],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+K" }, "description": "__MSG_cmd__" } },
  "minimum_chrome_version": "121"
}
